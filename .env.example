# ==============================================================================
# Enterprise Multi-Agent AI Platform Configuration
# ==============================================================================
APP_NAME=Healthcare-MultiAgent-Platform
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Google ADK / Gemini Settings
GEMINI_API_KEY="AIzaSyAjURRY6CU13H4ILYCWU434TiVv-NQvjuE"
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Cloud Deployment Mode: "gemini_api" or "vertex_ai"
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Guardrails Configuration
ENABLE_PHI_SCRUBBING=true
ENABLE_PROMPT_GUARD=true
ENABLE_CLINICAL_VERIFICATION=true
ENABLE_HUMAN_IN_THE_LOOP=true
HIGH_RISK_THRESHOLD=0.75

# Memory & Persistence
MEMORY_BACKEND=in_memory
REDIS_URL=redis://localhost:6379/0

# Observability
ENABLE_TELEMETRY=true
OTEL_SERVICE_NAME=healthcare-multiagent-service
LOG_LEVEL=INFO
STRUCTURED_JSON_LOGS=true
